# ============================================================================
# SPAD Dashboard — Variables d'environnement
# ============================================================================
# Copier ce fichier en .env.local pour développement, ou configurer chaque
# variable dans Vercel Project Settings → Environment Variables en prod.

# ----------------------------------------------------------------------------
# API KoboToolbox — obligatoire
# ----------------------------------------------------------------------------
# Base URL du serveur Kobo utilisé par le projet SPAD.
KOBO_BASE_URL=https://kf.kobotoolbox.org

# Token API personnel — jamais exposé au client.
# Récupérable sur https://kf.kobotoolbox.org/#/account/settings (API token).
KOBO_API_TOKEN=

# ----------------------------------------------------------------------------
# Asset UIDs des 7 formulaires Kobo à suivre
# ----------------------------------------------------------------------------
# Laisser vide un asset non encore déployé — l'app affichera un badge
# "Pas encore déployé" pour le formulaire concerné, sans erreur.
# Dès qu'un asset est renseigné, le formulaire bascule en suivi actif au
# prochain redéploiement / rafraîchissement (aucune modification de code).

# Formulaires enquêteurs — thématique tabac (PNLTA)
KOBO_ASSET_UID_F5=
KOBO_ASSET_UID_F6=

# Formulaires enquêteurs — thématique non-vaccination (PEV)
KOBO_ASSET_UID_F7=a5ekb5JGXjoxvNuVuTRDkB
KOBO_ASSET_UID_F8=a4PWc3ZXSCh3mTc8uFMs9F

# Formulaires superviseurs — revue des décès maternels (RDM)
KOBO_ASSET_UID_F01=aFWKA3KxQNuWX94CAJDnJc
KOBO_ASSET_UID_F02=aiM8m2nRQCcpKafBFm2cEi
KOBO_ASSET_UID_F07=aX28oeBgPfQhHW37NmAXve

# ----------------------------------------------------------------------------
# Authentification du dashboard — mot de passe partagé unique (V1)
# ----------------------------------------------------------------------------
# Mot de passe distribué aux utilisateurs internes DIS.
DASHBOARD_PASSWORD=

# Clé de signature du cookie de session (au moins 32 caractères aléatoires).
# Générer avec:  openssl rand -base64 32
SESSION_SECRET=

# ----------------------------------------------------------------------------
# Base Postgres — historique des snapshots
# ----------------------------------------------------------------------------
# Sur Vercel: ajouter l'intégration Neon depuis le Marketplace — DATABASE_URL
# sera injecté automatiquement dans les 3 environnements (prod/preview/dev).
# En local:   renseigner l'URL de connexion Neon (ou Supabase pooler).
DATABASE_URL=

# ----------------------------------------------------------------------------
# Cron Vercel — protection de la route de snapshot quotidien
# ----------------------------------------------------------------------------
# Vercel définit automatiquement CRON_SECRET sur son cron infra ; en local,
# vous pouvez le renseigner pour tester la route manuellement.
CRON_SECRET=
